#!match=on
# 分层维持保证金清算:开一个名义价值落进 maintenanceMargin 高档位的大仓,暴跌强平。
# 维持保证金表 {1000:5, 100000:10}(scaleK=1000):notional<100000 走 rate 5,≥100000 走 rate 10。
# 本向量 price=10000 size=20 → notional=200000,压**高档(rate 10)**;现有 liq 向量都是小仓、只碰低档。
# 验证分层维持保证金下的强平触发/清算结算/费用 Rust 与 Java 逐行一致。events-on。
CUR id=1 digit=0
CUR id=2 digit=0
SYM_FUT id=10100 kind=PERP base=1 quote=2 baseScale=1 quoteScale=1 taker=20 maker=10 feeScale=0 initMargin=1 initMarginScaleK=100
MARK sym=10100 price=10000
USER uid=1
USER uid=2
BAL uid=1 cur=2 amount=6000 txid=1
BAL uid=2 cur=2 amount=2000000 txid=2
PLACE_FUT oid=10001 uid=1 sym=10100 price=10000 size=20 action=BID margin=ISOLATED leverage=1
PLACE_FUT oid=10002 uid=2 sym=10100 price=10000 size=20 action=ASK margin=CROSS leverage=1
PLACE_FUT oid=10003 uid=2 sym=10100 price=9920 size=50 action=BID margin=CROSS leverage=1
ENABLE_LIQ
MARK_AT sym=10100 price=500 ts=2000
SCAN
