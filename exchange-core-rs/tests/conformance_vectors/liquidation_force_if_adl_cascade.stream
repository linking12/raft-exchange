#!match=on
# 完整 FORCE→IF→ADL 三步级联:loser 巨亏、书面无流动性 → FORCE 拒;IF 注资**不足**(100 « 覆盖整仓所需)
# → IF all-or-nothing 拒 + 释放预留 → 逃逸 ADL 减盈利对手方。与 adl(无 IF,跳过 IF)/ futures_if_takeover(IF 足,停在 IF)
# 互补:此处 IF 被**试过并拒**,验证 IF 不足时正确升级到 ADL(预留释放 + 不重复接管)。events-on。
CUR id=1 digit=0
CUR id=2 digit=0
SYM_FUT id=10003 kind=PERP base=1 quote=2 baseScale=1 quoteScale=1 taker=2 maker=0 feeScale=1000 initMargin=1 initMarginScaleK=100
MARK sym=10003 price=1000
USER uid=1
USER uid=2
USER uid=3
BAL uid=1 cur=2 amount=5000 txid=1
BAL uid=2 cur=2 amount=50000 txid=2
BAL uid=3 cur=2 amount=4000000 txid=3
PLACE_FUT oid=1 uid=1 sym=10003 price=1000 size=5 action=BID margin=ISOLATED leverage=1
PLACE_FUT oid=2 uid=3 sym=10003 price=1000 size=5 action=ASK margin=CROSS leverage=1
PLACE_FUT oid=3 uid=2 sym=10003 price=1000 size=10 action=ASK margin=ISOLATED leverage=1
PLACE_FUT oid=4 uid=3 sym=10003 price=1000 size=10 action=BID margin=CROSS leverage=1
# IF 注资极少(100),远不足覆盖 loser 整仓 → IF 试后 all-or-nothing 拒 → 升级 ADL
IF_DEPOSIT sym=10003 amount=100 txid=100
ENABLE_LIQ
MARK_AT sym=10003 price=600 ts=2000
SCAN
