#!match=on
# ADL 多对手方:loser uid1 LONG15 巨亏强平,无书面流动性 → ADL 减多个盈利空仓对手方。
# 三个等权 winner(uid2/4/6 各 SHORT5 @1000,同价同量 → 同 risk_score)→ 考验 tie-break 选择序(Java sortByLong.reverseThis)+ 贪心分配(需减 15 = 5+5+5,三个都吃)+ 逐对手方 ADL_POSITION_CLOSE 事件。
# uid3 深流动性提供者(开仓用,最终净平)。镜像 adl 但多对手方。events-on。
CUR id=1 digit=0
CUR id=2 digit=0
SYM_FUT id=10030 kind=PERP base=1 quote=2 baseScale=1 quoteScale=1 taker=2 maker=0 feeScale=1000 initMargin=1 initMarginScaleK=100
MARK sym=10030 price=1000
USER uid=1
USER uid=2
USER uid=3
USER uid=4
USER uid=6
BAL uid=1 cur=2 amount=5000 txid=1
BAL uid=2 cur=2 amount=50000 txid=2
BAL uid=3 cur=2 amount=8000000 txid=3
BAL uid=4 cur=2 amount=50000 txid=4
BAL uid=6 cur=2 amount=50000 txid=6
# loser 开 LONG15(uid3 对手)
PLACE_FUT oid=1 uid=3 sym=10030 price=1000 size=15 action=ASK margin=CROSS leverage=1
PLACE_FUT oid=2 uid=1 sym=10030 price=1000 size=15 action=BID margin=ISOLATED leverage=1
# 三个 winner 各开 SHORT5(uid3 对手,uid3 最终净平)
PLACE_FUT oid=3 uid=2 sym=10030 price=1000 size=5 action=ASK margin=ISOLATED leverage=1
PLACE_FUT oid=4 uid=3 sym=10030 price=1000 size=5 action=BID margin=CROSS leverage=1
PLACE_FUT oid=5 uid=4 sym=10030 price=1000 size=5 action=ASK margin=ISOLATED leverage=1
PLACE_FUT oid=6 uid=3 sym=10030 price=1000 size=5 action=BID margin=CROSS leverage=1
PLACE_FUT oid=7 uid=6 sym=10030 price=1000 size=5 action=ASK margin=ISOLATED leverage=1
PLACE_FUT oid=8 uid=3 sym=10030 price=1000 size=5 action=BID margin=CROSS leverage=1
ENABLE_LIQ
MARK_AT sym=10030 price=600 ts=2000
SCAN
