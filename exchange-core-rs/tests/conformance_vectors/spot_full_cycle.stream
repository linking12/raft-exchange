# 现货全周期:两币 + 一个无费现货对 + 两用户,卖1买1 @20000 撮合。
# 规范命令流(与实现无关);Java ConformanceExporter 与 Rust conformance 各自解释。
CUR id=1 digit=0
CUR id=2 digit=0
SYM_SPOT id=100 base=1 quote=2 baseScale=1 quoteScale=1 taker=0 maker=0
USER uid=1
USER uid=2
BAL uid=1 cur=1 amount=1000000 txid=1
BAL uid=2 cur=2 amount=10000000 txid=2
PLACE oid=101 uid=1 sym=100 price=20000 size=1 action=ASK type=GTC
PLACE oid=102 uid=2 sym=100 price=20000 size=1 action=BID type=GTC reserve=20000
