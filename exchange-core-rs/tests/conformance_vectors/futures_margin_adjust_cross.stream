# CROSS 追加保证金:CROSS 下 MARGIN_ADJUST 语义等价 BALANCE_ADJUSTMENT 充值(cmd.symbol=currency)。
# uid1 CROSS LONG10@1000,再 MARGIN_ADJUST margin=CROSS sym=2(currency) amount=5000 → 账户充值 5000。
# 验证 CROSS 分支(复用 balance_adjustment 原语)两侧一致,区别于 ISOLATED 的 extra_margin 内部搬移。events-on。
CUR id=1 digit=0
CUR id=2 digit=0
SYM_FUT id=8010 kind=PERP base=1 quote=2 baseScale=1 quoteScale=1 taker=0 maker=0 feeScale=0 initMargin=1 initMarginScaleK=10
MARK sym=8010 price=1000
USER uid=1
USER uid=2
BAL uid=1 cur=2 amount=1000000 txid=1
BAL uid=2 cur=2 amount=1000000 txid=2
PLACE_FUT oid=1 uid=2 sym=8010 price=1000 size=10 action=ASK margin=CROSS leverage=1
PLACE_FUT oid=2 uid=1 sym=8010 price=1000 size=10 action=BID margin=CROSS leverage=1
MARGIN_ADJUST uid=1 sym=2 action=BID amount=5000 margin=CROSS txid=100
