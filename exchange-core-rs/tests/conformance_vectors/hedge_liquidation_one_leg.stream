#!match=on
# HEDGE 单腿清算:uid1 双向 ISOLATED 持仓 LONG10 + SHORT5;mark 硬暴跌(1000→500)。
# LONG 腿(逐仓)亏损被击穿 → 只强平 LONG 腿(+symbol),SHORT 腿(-symbol,暴跌下反而浮盈)保留、不被误伤。
# 对手方 uid2 高价 BID@990 覆盖 → 干净 FORCE(不逃 ADL)。验证清算按 create_positions_key 精确定位亏损腿。events-on。
CUR id=1 digit=0
CUR id=2 digit=0
SYM_FUT id=10040 kind=PERP base=1 quote=2 baseScale=1 quoteScale=1 taker=0 maker=0 feeScale=0 initMargin=1 initMarginScaleK=100
MARK sym=10040 price=1000
USER uid=1
USER uid=2
USER uid=3
BAL uid=1 cur=2 amount=3000 txid=1
BAL uid=2 cur=2 amount=10000000 txid=2
BAL uid=3 cur=2 amount=10000000 txid=3
POS_MODE uid=1 hedge=1
# 开 LONG 腿(uid2 卖)+ SHORT 腿(uid3 买)
PLACE_FUT oid=1 uid=2 sym=10040 price=1000 size=10 action=ASK margin=CROSS leverage=1
PLACE_FUT oid=2 uid=1 sym=10040 price=1000 size=10 action=BID margin=ISOLATED leverage=1
PLACE_FUT oid=3 uid=3 sym=10040 price=1000 size=5 action=BID margin=CROSS leverage=1
PLACE_FUT oid=4 uid=1 sym=10040 price=1000 size=5 action=ASK margin=ISOLATED leverage=1
# 高价 BID 覆盖 LONG 腿的清算卖单
PLACE_FUT oid=5 uid=2 sym=10040 price=990 size=20 action=BID margin=CROSS leverage=1
ENABLE_LIQ
MARK_AT sym=10040 price=500 ts=2000
SCAN
