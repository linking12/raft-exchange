# 多 symbol 交割:uid1 同时持 A/B 两个交割 symbol 的多头,分别在不同交割价结算(A 盈利、B 亏损)。
# 验证 SETTLE_PNL 按 symbol 独立结算(A@1200 多头+2000、B@800 多头-2000),互不干扰,账户净 0。events-on。
CUR id=1 digit=0
CUR id=2 digit=0
SYM_FUT id=10060 kind=DELIVERY base=1 quote=2 baseScale=1 quoteScale=1 taker=0 maker=0 feeScale=0 initMargin=1 initMarginScaleK=100
SYM_FUT id=10061 kind=DELIVERY base=1 quote=2 baseScale=1 quoteScale=1 taker=0 maker=0 feeScale=0 initMargin=1 initMarginScaleK=100
MARK sym=10060 price=1000
MARK sym=10061 price=1000
USER uid=1
USER uid=2
BAL uid=1 cur=2 amount=1000000 txid=1
BAL uid=2 cur=2 amount=1000000 txid=2
PLACE_FUT oid=1 uid=2 sym=10060 price=1000 size=10 action=ASK margin=CROSS leverage=1
PLACE_FUT oid=2 uid=1 sym=10060 price=1000 size=10 action=BID margin=CROSS leverage=1
PLACE_FUT oid=3 uid=2 sym=10061 price=1000 size=10 action=ASK margin=CROSS leverage=1
PLACE_FUT oid=4 uid=1 sym=10061 price=1000 size=10 action=BID margin=CROSS leverage=1
SETTLE_PNL sym=10060 price=1200 txid=1
SETTLE_PNL sym=10061 price=800 txid=2
