# 逐仓期货 MARGIN_ALERT:mark 落入告警带(mm ≤ equity < mm*6/5)但未触发强平,发一条 MARGIN_ALERT。
# 单次 MARK_AT 触发(告警非幂等,不加 SCAN 避免重复捕获)。uid=1 逐仓多头进告警带,uid=2 cross 空头大额保持健康。
CUR id=1 digit=0
CUR id=2 digit=0
SYM_FUT id=10000 kind=PERP base=1 quote=2 baseScale=1 quoteScale=1 taker=0 maker=0 feeScale=0 initMargin=1 initMarginScaleK=100
MARK sym=10000 price=10000
USER uid=1
USER uid=2
BAL uid=1 cur=2 amount=3000 txid=1
BAL uid=2 cur=2 amount=1000000 txid=2
PLACE_FUT oid=1 uid=2 sym=10000 price=10000 size=10 action=ASK margin=CROSS leverage=1
PLACE_FUT oid=2 uid=1 sym=10000 price=10000 size=10 action=BID margin=ISOLATED leverage=1
ENABLE_LIQ
# P=9955: mm=497, equity=550, mm*6/5=596 -> 497<=550<596 -> MARGIN_ALERT uid=1
MARK_AT sym=10000 price=9955 ts=2000
