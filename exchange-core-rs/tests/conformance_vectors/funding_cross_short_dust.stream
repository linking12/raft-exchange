# 资金费 SHORT payer 方向(action=ASK)+ CROSS 保证金 + 多 receiver dust —— perp_funding/其余向量都是 BID/LONG payer,补对侧。
# uid1 SHORT30(payer,action=ASK 同向),uid2/3/4 LONG10(receivers)。
# payer fee=trunc(30000/300)=100;每 receiver=trunc(100*10000/30000)=33,Σ=99,余数 1 按 uid 升序 → uid2=34,uid3/4=33。
# 验证 payer=SHORT / receiver=LONG 方向对称 + CROSS 保证金下 funding 结算。events-on。
CUR id=1 digit=0
CUR id=2 digit=0
SYM_FUT id=10000 kind=PERP base=1 quote=2 baseScale=1 quoteScale=1 taker=0 maker=0 feeScale=0 initMargin=1 initMarginScaleK=100
MARK sym=10000 price=1000
USER uid=1
USER uid=2
USER uid=3
USER uid=4
BAL uid=1 cur=2 amount=1000000 txid=1
BAL uid=2 cur=2 amount=1000000 txid=2
BAL uid=3 cur=2 amount=1000000 txid=3
BAL uid=4 cur=2 amount=1000000 txid=4
PLACE_FUT oid=1 uid=2 sym=10000 price=1000 size=10 action=BID margin=CROSS leverage=1
PLACE_FUT oid=2 uid=3 sym=10000 price=1000 size=10 action=BID margin=CROSS leverage=1
PLACE_FUT oid=3 uid=4 sym=10000 price=1000 size=10 action=BID margin=CROSS leverage=1
PLACE_FUT oid=4 uid=1 sym=10000 price=1000 size=30 action=ASK margin=CROSS leverage=1
