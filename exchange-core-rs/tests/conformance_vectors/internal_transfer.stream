# INTERNAL_TRANSFER 资金事件进③对拍:用户间同币种原子转账,双腿(from/to)各发一条 INTERNAL_TRANSFER FE。
# 覆盖成功转账 + 自转账拒绝(INVALID_SELF)+ 余额不足拒绝(RISK_NSF)+ 回流转账,验证双腿事件不多发/漏发/错值。
CUR id=1 digit=0
USER uid=1
USER uid=2
BAL uid=1 cur=1 amount=1000 txid=1
# 成功:uid1 -> uid2 转 300;from 腿 free=700、to 腿 free=300 各一条 INTERNAL_TRANSFER
TRANSFER from=1 to=2 cur=1 amount=300 txid=2
# 自转账 -> INTERNAL_TRANSFER_INVALID_SELF,无 FE
TRANSFER from=1 to=1 cur=1 amount=100 txid=3
# 余额不足(uid2 仅 300)-> RISK_NSF,无 FE
TRANSFER from=2 to=1 cur=1 amount=100000 txid=4
# 回流:uid2 -> uid1 转 50;from 腿 free=250、to 腿 free=750
TRANSFER from=2 to=1 cur=1 amount=50 txid=5
