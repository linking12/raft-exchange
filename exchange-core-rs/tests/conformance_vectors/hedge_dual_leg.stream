# HEDGE 双向持仓:同一 symbol 同时持 LONG + SHORT 两腿(不轧差)。
# uid=1 切 HEDGE 模式,先吃 uid=2 的卖单开 LONG 腿,再吃 uid=3 的买单开 SHORT 腿。
# 终态 uid=1 在 sym=7001 上有两条 POS(LONG/SHORT 各一),核对两侧双腿的存在/量/开仓价一致。
CUR id=1 digit=0
CUR id=2 digit=0
SYM_FUT id=7001 kind=PERP base=1 quote=2 baseScale=1 quoteScale=1 taker=0 maker=0 feeScale=0 initMargin=1 initMarginScaleK=10
MARK sym=7001 price=1000
USER uid=1
USER uid=2
USER uid=3
BAL uid=1 cur=2 amount=1000000 txid=1
BAL uid=2 cur=2 amount=1000000 txid=2
BAL uid=3 cur=2 amount=1000000 txid=3
# uid=1 切双向持仓
POS_MODE uid=1 hedge=1
# uid=2 挂卖、uid=3 挂买(maker,ONEWAY);uid=1 分别吃单 → LONG 腿 + SHORT 腿共存
PLACE_FUT oid=1 uid=2 sym=7001 price=1000 size=5 action=ASK margin=ISOLATED leverage=1
PLACE_FUT oid=2 uid=1 sym=7001 price=1000 size=5 action=BID margin=ISOLATED leverage=1
PLACE_FUT oid=3 uid=3 sym=7001 price=1000 size=5 action=BID margin=ISOLATED leverage=1
PLACE_FUT oid=4 uid=1 sym=7001 price=1000 size=5 action=ASK margin=ISOLATED leverage=1
