# 逐仓多头暴跌被强平。镜像 it_liquidation basic_liquidation_isolated_long。
# Java 需 SCAN(triggerLiquidation,exporter 循环触发至级联 settle)触发;Rust MARK_AT 即定向扫。
# 状态 + 结算类 fund event(LIQUIDATION_CLOSE/FEE/PNL_SETTLEMENT)均对拍 Java。
#!match=on
CUR id=1 digit=0
CUR id=2 digit=0
SYM_FUT id=10000 kind=PERP base=1 quote=2 baseScale=1 quoteScale=1 taker=20 maker=10 feeScale=0 initMargin=1 initMarginScaleK=100
MARK sym=10000 price=10000
USER uid=1
USER uid=2
BAL uid=1 cur=2 amount=3000 txid=1
BAL uid=2 cur=2 amount=1000000 txid=2
PLACE_FUT oid=10001 uid=1 sym=10000 price=10000 size=10 action=BID margin=ISOLATED leverage=1
PLACE_FUT oid=10002 uid=2 sym=10000 price=10000 size=10 action=ASK margin=CROSS leverage=1
PLACE_FUT oid=10003 uid=2 sym=10000 price=9920 size=25 action=BID margin=CROSS leverage=1
ENABLE_LIQ
MARK_AT sym=10000 price=500 ts=2000
SCAN
