# 镜像 it_liquidation basic_liquidation_isolated_long。Java 需 SCAN(triggerLiquidation)触发;Rust MARK_AT 即定向扫。
CUR id=1 digit=0
CUR id=2 digit=0
SYM_FUT id=10000 kind=PERP base=1 quote=2 baseScale=1 quoteScale=1 taker=20 maker=10 feeScale=0 initMargin=1 initMarginScaleK=100
MARK sym=10000 price=10000
USER uid=1
USER uid=2
BAL uid=1 cur=2 amount=3000 txid=1
