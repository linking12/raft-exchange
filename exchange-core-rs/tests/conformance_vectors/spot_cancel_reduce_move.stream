# 撮合执行报告(match event)进③:现货 REDUCE / CANCEL / MOVE(下移穿越挂单产生成交) 三类执行报告。
# 覆盖 NEW / REDUCE / CANCEL / TRADE(经 MOVE 触发,taker=移动方),逐字段对拍 Java oracle。
# 注:刻意不做"MOVE 成交后再 CANCEL 同一单"——Java mover 的 filledNotional 不累计(quirk),Rust 累计,
# 会在 cancel 报告 cumQ 分歧(见 CONSISTENCY §6);此处规避,单独发现单报告。
#!match=on
CUR id=1 digit=0
CUR id=2 digit=0
SYM_SPOT id=100 base=1 quote=2 baseScale=1 quoteScale=1 taker=0 maker=0
USER uid=1
USER uid=2
BAL uid=1 cur=1 amount=1000000 txid=1
BAL uid=2 cur=2 amount=1000000 txid=2
# uid=2 挂 BID 90x5(NEW)
PLACE oid=2 uid=2 sym=100 price=90 size=5 action=BID type=GTC reserve=90
# uid=1 挂 ASK 100x10(NEW)
PLACE oid=1 uid=1 sym=100 price=100 size=10 action=ASK type=GTC
# 减仓 ASK 3(10->7,无成交) -> REDUCE 报告(status NEW)
REDUCE oid=1 uid=1 sym=100 size=3
# uid=1 另挂 ASK 110x4(NEW),随即撤掉(无成交) -> CANCEL 报告(status CANCELED)
PLACE oid=3 uid=1 sym=100 price=110 size=4 action=ASK type=GTC
CANCEL oid=3 uid=1 sym=100
# ASK oid=1 下移到 90 穿越 BID@90 -> MOVE 触发 TRADE(taker=移动方 ASK, maker=BID)
MOVE oid=1 uid=1 sym=100 price=90
