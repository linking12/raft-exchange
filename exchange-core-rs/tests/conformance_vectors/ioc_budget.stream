# IOC_BUDGET(已实现):BID 预算内尽量买,超预算/走完就停,余量撤。
# 预算 15000 够买 1 手(10000),第 2 手需 10000 但预算只剩 5000 → 只成 1 手。
CUR id=1 digit=0
CUR id=2 digit=0
SYM_SPOT id=100 base=1 quote=2 baseScale=1 quoteScale=1 taker=0 maker=0
USER uid=1
USER uid=2
BAL uid=1 cur=2 amount=1000000000 txid=1
BAL uid=2 cur=1 amount=1000000 txid=2
PLACE oid=1 uid=2 sym=100 price=10000 size=1 action=ASK type=GTC
PLACE oid=2 uid=2 sym=100 price=10000 size=1 action=ASK type=GTC
PLACE oid=3 uid=1 sym=100 price=15000 size=2 action=BID type=IOC_BUDGET reserve=15000
