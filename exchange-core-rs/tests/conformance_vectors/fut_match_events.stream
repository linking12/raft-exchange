# 撮合执行报告(match event)进③对拍:期货 NEW / TRADE(taker+maker) / counterparty / avgPx / fee /
# positionSide 按各自 uid 独立查表(uid=2 HEDGE、maker uid=1 ONEWAY)。
# 经 SimpleEventsProcessor 产出 FuturesExecutionReport,ERF 行按发出顺序逐字段对拍 Java oracle。
#!match=on
CUR id=1 digit=0
CUR id=2 digit=0
SYM_FUT id=200 kind=PERP base=1 quote=2 baseScale=1 quoteScale=1 taker=2 maker=1 feeScale=1000 initMargin=1 initMarginScaleK=100
MARK sym=200 price=1000
USER uid=1
BAL uid=1 cur=2 amount=100000000 txid=1
USER uid=2
BAL uid=2 cur=2 amount=100000000 txid=2
# uid=2 空仓时切 HEDGE -> 其后所有 report posSide=HEDGE;maker uid=1 保持 ONEWAY
POS_MODE uid=2 hedge=1
# maker ASK, taker BID -> NEW + TRADE taker/maker,cp 互指,posSide 各自独立
PLACE_FUT oid=1 uid=1 sym=200 price=1000 size=5 action=ASK type=GTC leverage=2 margin=CROSS
PLACE_FUT oid=2 uid=2 sym=200 price=1000 size=5 action=BID type=GTC leverage=2 margin=ISOLATED
# 再开一笔,验证多笔一致
PLACE_FUT oid=3 uid=1 sym=200 price=1010 size=3 action=ASK type=GTC leverage=2 margin=CROSS
PLACE_FUT oid=4 uid=2 sym=200 price=1010 size=3 action=BID type=GTC leverage=2 margin=ISOLATED
