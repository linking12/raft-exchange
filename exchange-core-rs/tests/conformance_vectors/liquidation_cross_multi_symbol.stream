#!match=on
# CROSS 跨仓清算(干净 FORCE,无 ADL):uid1 用同一账户在 A/B 两 symbol 各开 CROSS LONG10(共享保证金)。
# A mark 硬暴跌(1000→500)触发 cross 账户级维持保证金击穿 → 清算 A;对手方 uid2 在 A 高位挂 BID@990(覆盖价),
# FORCE 清算单直接成交(不逃逸到 ADL)→ A 平仓、B 保留、uid1 未破产。镜像 liquidation_isolated 的「硬暴跌触发 + 高价 BID 覆盖」。
# 验证 CROSS 账户级判定(A亏与B共担同一余额)+ 单次 FORCE 清算事件级两侧一致。events-on。
CUR id=1 digit=0
CUR id=2 digit=0
SYM_FUT id=10020 kind=PERP base=1 quote=2 baseScale=1 quoteScale=1 taker=0 maker=0 feeScale=0 initMargin=1 initMarginScaleK=100
SYM_FUT id=10021 kind=PERP base=1 quote=2 baseScale=1 quoteScale=1 taker=0 maker=0 feeScale=0 initMargin=1 initMarginScaleK=100
MARK sym=10020 price=1000
MARK sym=10021 price=1000
USER uid=1
USER uid=2
BAL uid=1 cur=2 amount=3000 txid=1
BAL uid=2 cur=2 amount=10000000 txid=2
PLACE_FUT oid=1 uid=2 sym=10020 price=1000 size=10 action=ASK margin=CROSS leverage=1
PLACE_FUT oid=2 uid=1 sym=10020 price=1000 size=10 action=BID margin=CROSS leverage=1
PLACE_FUT oid=3 uid=2 sym=10021 price=1000 size=10 action=ASK margin=CROSS leverage=1
PLACE_FUT oid=4 uid=1 sym=10021 price=1000 size=10 action=BID margin=CROSS leverage=1
# uid2 在 A 高位挂 BID@990 吸收清算卖单(覆盖价 → FORCE 成交,不逃逸 ADL)
PLACE_FUT oid=5 uid=2 sym=10020 price=990 size=20 action=BID margin=CROSS leverage=1
ENABLE_LIQ
MARK_AT sym=10020 price=500 ts=2000
SCAN
